import 'dart:typed_data';
import 'package:flutter/material.dart';
import 'package:flutter_animate/flutter_animate.dart';
import 'package:google_fonts/google_fonts.dart';
import 'package:image_picker/image_picker.dart';
import 'package:provider/provider.dart';

import '../main.dart';
import '../services/api_service.dart';

class CurrencyScannerScreen extends StatefulWidget {
  const CurrencyScannerScreen({super.key});
  @override
  State<CurrencyScannerScreen> createState() => _CurrencyScannerScreenState();
}

class _CurrencyScannerScreenState extends State<CurrencyScannerScreen> {
  Uint8List? _imageBytes;
  bool _analyzing = false;
  CurrencyAnalysisResult? _result;
  final _picker = ImagePicker();

  Future<void> _pickImage(ImageSource source) async {
    final picked = await _picker.pickImage(source: source, imageQuality: 85, maxWidth: 1600);
    if (picked == null) return;
    final bytes = await picked.readAsBytes();
    if (!mounted) return;
    setState(() {
      _imageBytes = bytes;
      _result = null;
    });
  }

  Future<void> _analyze() async {
    if (_imageBytes == null) return;
    setState(() => _analyzing = true);
    try {
      final api = context.read<ApiService>();
      final lang = api.currentUser?.language ?? 'en';
      final result = await api.analyzeCurrency(_imageBytes!, language: lang);
      if (!mounted) return;
      setState(() => _result = result);
    } catch (e) {
      _showError(e.toString());
    } finally {
      if (mounted) setState(() => _analyzing = false);
    }
  }

  void _showError(String msg) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(msg),
        backgroundColor: AppColors.red,
        behavior: SnackBarBehavior.floating,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Counterfeit Currency Scanner'), centerTitle: false),
      body: SingleChildScrollView(
        padding: const EdgeInsets.fromLTRB(20, 8, 20, 100),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Photograph a banknote and our AI will check it for common counterfeit indicators.',
              style: GoogleFonts.inter(color: AppColors.textSec, fontSize: 13, height: 1.5),
            ),
            const SizedBox(height: 20),
            _buildUploadArea(),
            if (_imageBytes != null) ...[
              const SizedBox(height: 16),
              _buildScanButton(),
            ],
            if (_analyzing) ...[
              const SizedBox(height: 24),
              _buildAnalyzingState(),
            ],
            if (_result != null) ...[
              const SizedBox(height: 24),
              _buildResultCard(),
            ],
            const SizedBox(height: 20),
            _buildPrototypeNotice(),
          ],
        ),
      ),
    );
  }

  Widget _buildUploadArea() {
    if (_imageBytes != null) {
      return Stack(
        children: [
          Container(
            width: double.infinity,
            height: 220,
            decoration: BoxDecoration(
              borderRadius: BorderRadius.circular(16),
              border: Border.all(color: AppColors.blue.withValues(alpha: 0.4), width: 1.5),
            ),
            child: ClipRRect(
              borderRadius: BorderRadius.circular(15),
              child: Image.memory(_imageBytes!, fit: BoxFit.cover),
            ),
          ),
          Positioned(
            top: 8,
            right: 8,
            child: GestureDetector(
              onTap: () => setState(() { _imageBytes = null; _result = null; }),
              child: Container(
                padding: const EdgeInsets.all(6),
                decoration: BoxDecoration(color: Colors.black.withValues(alpha: 0.7), shape: BoxShape.circle),
                child: const Icon(Icons.close, color: Colors.white, size: 16),
              ),
            ),
          ),
        ],
      );
    }

    return Row(
      children: [
        Expanded(
          child: GestureDetector(
            onTap: () => _pickImage(ImageSource.camera),
            child: _uploadTile(Icons.camera_alt_outlined, 'Take Photo'),
          ),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: GestureDetector(
            onTap: () => _pickImage(ImageSource.gallery),
            child: _uploadTile(Icons.upload_rounded, 'Upload Image'),
          ),
        ),
      ],
    ).animate().fadeIn().scale(begin: const Offset(0.97, 0.97));
  }

  Widget _uploadTile(IconData icon, String label) {
    return Container(
      height: 140,
      decoration: BoxDecoration(
        color: AppColors.surface,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: AppColors.border, width: 1.5),
      ),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Container(
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(color: AppColors.blue.withValues(alpha: 0.1), shape: BoxShape.circle),
            child: Icon(icon, color: AppColors.blue, size: 26),
          ),
          const SizedBox(height: 10),
          Text(label,
              style: GoogleFonts.inter(color: AppColors.textPrim, fontWeight: FontWeight.w700, fontSize: 13)),
        ],
      ),
    );
  }

  Widget _buildScanButton() {
    return SizedBox(
      width: double.infinity,
      child: ElevatedButton.icon(
        onPressed: _analyzing ? null : _analyze,
        icon: const Icon(Icons.currency_exchange, size: 18),
        label: const Text('Scan Note'),
        style: ElevatedButton.styleFrom(
          padding: const EdgeInsets.symmetric(vertical: 16),
          textStyle: GoogleFonts.inter(fontSize: 15, fontWeight: FontWeight.w800),
        ),
      ),
    ).animate().fadeIn().slideY(begin: 0.2, end: 0);
  }

  Widget _buildAnalyzingState() {
    return Center(
      child: Column(
        children: [
          const CircularProgressIndicator(color: AppColors.blue, strokeWidth: 3),
          const SizedBox(height: 16),
          Text('Processing...',
              style: GoogleFonts.inter(color: AppColors.textSec, fontSize: 14)),
          const SizedBox(height: 6),
          Text('Checking watermark, security thread, and print quality cues',
              style: GoogleFonts.inter(color: AppColors.textMuted, fontSize: 12),
              textAlign: TextAlign.center),
        ],
      ),
    ).animate().fadeIn();
  }

  Widget _buildResultCard() {
    final r = _result!;
    final isGenuine = r.likelyGenuine;
    final color = isGenuine ? AppColors.green : AppColors.orange;
    final icon = isGenuine ? Icons.check_circle : Icons.warning_amber_rounded;
    final label = isGenuine ? 'Genuine Note' : 'Potential Counterfeit';

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Container(
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            color: AppColors.surface,
            borderRadius: BorderRadius.circular(16),
            border: Border.all(color: color.withValues(alpha: 0.4)),
          ),
          child: Row(
            children: [
              Icon(icon, color: color, size: 28),
              const SizedBox(width: 12),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(label,
                        style: GoogleFonts.inter(color: AppColors.textPrim, fontWeight: FontWeight.w800, fontSize: 16)),
                    const SizedBox(height: 4),
                    Text('${r.confidencePercent}% confidence',
                        style: GoogleFonts.inter(color: color, fontWeight: FontWeight.w700, fontSize: 13)),
                  ],
                ),
              ),
            ],
          ),
        ).animate().fadeIn().scale(begin: const Offset(0.95, 0.95)),
        if (r.reasons.isNotEmpty) ...[
          const SizedBox(height: 14),
          Text('Reasons',
              style: GoogleFonts.inter(color: AppColors.textPrim, fontWeight: FontWeight.w700, fontSize: 14)),
          const SizedBox(height: 10),
          ...r.reasons.asMap().entries.map(
            (e) => Container(
              margin: const EdgeInsets.only(bottom: 8),
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
              decoration: BoxDecoration(
                color: color.withValues(alpha: 0.07),
                borderRadius: BorderRadius.circular(10),
                border: Border.all(color: color.withValues(alpha: 0.2)),
              ),
              child: Text('• ${e.value}',
                  style: GoogleFonts.inter(color: AppColors.textPrim, fontSize: 13, height: 1.4)),
            ).animate().fadeIn(delay: (80 * e.key).ms),
          ),
        ],
      ],
    );
  }

  Widget _buildPrototypeNotice() {
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: AppColors.surface2,
        borderRadius: BorderRadius.circular(10),
        border: Border.all(color: AppColors.border),
      ),
      child: Text(
        'Prototype notice: this uses a general-purpose vision model as a proof of concept and is not a certified currency authentication system.',
        style: GoogleFonts.inter(color: AppColors.textMuted, fontSize: 11.5, height: 1.4),
      ),
    );
  }
}
