# NexusShield Backend — environment configuration
# Copy to .env and fill in. Anything left blank degrades gracefully
# (the matching feature reports "not_configured" instead of crashing).

# Required for AI analysis
GEMINI_API_KEY=
# Optional: override the default model (defaults to gemini-2.5-flash)
GEMINI_MODEL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Database (defaults to local SQLite file if unset)
DATABASE_URL=

# Phase 7 - External integrations (all optional)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=

# Phase 1 - OAuth (needed to verify Google/Apple id_tokens server-side in production)
# Sign-in token verification (/auth/oauth). Set at least one.
# Firebase project ID -> accepts Firebase ID tokens
FIREBASE_PROJECT_ID=
# Google Cloud project number -> accepts Google ID tokens from that project's client IDs
GOOGLE_PROJECT_NUMBER=
# Or list allowed Google OAuth client IDs (comma-separated)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Phase 9 - Push notifications (Firebase Cloud Messaging)
FCM_SERVICE_ACCOUNT_PATH=
