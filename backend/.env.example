# NexusShield Backend — environment configuration
# Copy to .env and fill in. Anything left blank degrades gracefully
# (the matching feature reports "not_configured" instead of crashing).

# Required for AI analysis
GEMINI_API_KEY=
# Optional: override the default model (defaults to gemini-2.5-flash)
GEMINI_MODEL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Database (defaults to local SQLite file if unset)
DATABASE_URL=

# Phase 7 - External integrations (all optional)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=

# Internship offer verification (optional; falls back to DuckDuckGo if unset)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Phase 1 - OAuth (needed to verify Google/Apple id_tokens server-side in production)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Phase 9 - Push notifications (Firebase Cloud Messaging)
FCM_SERVICE_ACCOUNT_PATH=

# Email (SMTP) — for OTP / verification / password reset emails
# Leave blank for dev mode (tokens/OTPs returned in API response instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
